# Paste this into Streamlit Community Cloud:
#   your app > Settings > Secrets
# Do NOT commit the real secrets.toml to GitHub.

GOOGLE_API_KEY = "paste-your-ai-studio-key-here"
GEMINI_MODEL_PRO = "gemini-3.6-flash"
GEMINI_MODEL_FLASH = "gemini-3.6-flash"
# Optional: used only if GEMINI_MODEL_PRO exhausts retries on a 429/503 overload.
# Defaults to "gemini-3.5-flash-lite" in code if you don't set this.
# GEMINI_MODEL_FALLBACK = "gemini-3.5-flash-lite"

CLICKHOUSE_HOST = "xxxxxxxx.us-central1.gcp.clickhouse.cloud"
CLICKHOUSE_PORT = "8443"
CLICKHOUSE_USER = "default"
CLICKHOUSE_PASSWORD = "your-clickhouse-password"
CLICKHOUSE_DATABASE = "default"

DEMO_PROJECT_ID = "demo_feature"
