# ---- Gemini (FREE - no credit card) ----
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=paste-your-ai-studio-key-here
GEMINI_MODEL_PRO=gemini-3.6-flash
GEMINI_MODEL_FLASH=gemini-3.6-flash

# ---- ClickHouse Cloud (free 30-day trial, no card) ----
# From ClickHouse Cloud > your service > Connect > HTTPS
CLICKHOUSE_HOST=your-service.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your-clickhouse-password
CLICKHOUSE_DATABASE=default

DEMO_PROJECT_ID=demo_feature
